def validate_text(text_input):
    """
    Ensures the text input is not empty or just whitespace.
    """
    if not text_input or text_input.strip() == "":
        return False, "Error: Text input cannot be empty."
    return True, text_input
      def validate_key(key_input):
    """
    Ensures the key is a valid integer between 0 and 25.
    """
    try:
        key = int(key_input)
        if 0 <= key <= 25:
            return True, key
        else:
            return False, "Error: The shift key must be an integer between 0 and 25."
    except ValueError:
        return False, "Error: Invalid input. Please enter a numeric integer value for the key."
          def decrypt_caesar(ciphertext, key):
    """
    Decrypts ciphertext using the Caesar Cipher formula: P = (C - K) mod 26
    Preserves case (uppercase/lowercase) and leaves spaces/punctuation unchanged.
    """
    decrypted_text = ""
    for char in ciphertext:
        if char.isupper():
            # Decrypt uppercase characters (ASCII 65-90)
            decrypted_char = chr((ord(char) - 65 - key) % 26 + 65)
            decrypted_text += decrypted_char
        elif char.islower():
            # Decrypt lowercase characters (ASCII 97-122)
            decrypted_char = chr((ord(char) - 97 - key) % 26 + 97)
            decrypted_text += decrypted_char
        else:
            # Leave spaces, numbers, and punctuation untouched
            decrypted_text += char
    return decrypted_text
